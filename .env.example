# Copy this file to a new file called .env and paste your key after the = sign.
# .env is private: it is listed in .gitignore so it is never uploaded to GitHub.
# Leave the key empty to run in free demo mode with built-in examples.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5. Set claude-haiku-5-5 for a much cheaper model.
CLAUDE_MODEL=
